NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=
NEXT_PUBLIC_API_BASE_URL=https://api.on-squad.com

# Sentry — DSN 은 공개 값이라 클라이언트 번들에 박혀도 된다. 비우면 관측이 콘솔로만 흐른다.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# 아래는 빌드 타임 전용. SENTRY_AUTH_TOKEN 은 시크릿이라 커밋 금지 — .env.local / Vercel 환경변수에만 둔다.
# 토큰이 없으면 소스맵을 안 올리고, 스택 트레이스가 난독화된 채로 수집된다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
